# Slooh account credentials used by the proxy server (do not commit this file)
SLOOH_EMAIL=your-email@example.com
SLOOH_PASSWD=your-password

# Port the proxy listens on (the web app proxies /api and /sse to it)
SLOOH_PROXY_PORT=8270

# API key for authenticating API requests (Authorization: Bearer <key> or X-API-Key: <key>)
API_KEY=your-api-key-here

# Password for the web login page (defaults to API_KEY if not set)
WEB_PASSWORD=your-web-password-here
